#from benchmarks.cheetah_base import BasePage
#extends BasePage

#def topic_list($topics)
<div>
#for $index, $topic in enumerate($topics)
  <span>$escape_text($topic)</span>
#if $index < len($topics) - 1
  ,
#end if
#end for
</div>
#end def
#block head
<title>Articles</title>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/static/site.css">
<script src="/static/app.js" defer></script>
#end block

#block navigation
  <nav>
    <h2>Browse topics</h2>
    $topic_list($topic_index)
  </nav>
#end block

#block content
  <ul>
#for $item in $articles
#set $featured_class = ' class="featured"' if $item['featured'] else ''
#set $hidden_attr = ' hidden' if $item['draft'] else ''
#set $link_attrs = ' target="_blank" rel="noopener"' if $item['external'] else ''
    <li$featured_class data-category="$escape_attr($item['category'])"$hidden_attr>
      <!-- article $item['id'] -->
      <img src="$escape_attr($item['thumbnail'])" alt="$escape_attr($item['title'])" width="64" height="64" loading="lazy">
      <a href="$escape_attr($item['url'])"$link_attrs>$escape_text($item['title'])</a>
      <p>$escape_text($item['summary'])</p>
#if $item['featured']
      <strong>Featured</strong>
#end if
      <span>$escape_text($item['category'])</span>
      <span class="rating">$item['rating']</span>
#if $item['author']
      <small><span>By $escape_text($item['author'])</span></small>
#end if
#if $item['tags']
      $topic_list($item['tags'])
#end if
#if $item['comments']
      <span>$item['comments'] comments</span>
#end if
    </li>
#end for
  </ul>
#end block
